# OcularAudio v1.3.0 production configuration
OCULAR_AUDIO_MCP_REQUIRE_AUTH=false
OCULAR_AUDIO_MCP_AUTH_TOKEN=
OCULAR_AUDIO_MCP_ISSUER_URL=https://auth.example.com
OCULAR_AUDIO_MCP_RESOURCE_URL=https://mcp.example.com/mcp
OCULAR_AUDIO_MCP_REQUIRED_SCOPES=mcp:read,mcp:analyze
OCULAR_AUDIO_MCP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:*
OCULAR_AUDIO_MCP_ALLOWED_ORIGINS=https://app.example.com
OCULAR_AUDIO_MCP_TOKEN_TTL=3600
